# Browser key already used by the dashboard's Google Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional dedicated website/API-restricted Maps Static API key (preferred).
NEXT_PUBLIC_GOOGLE_MAPS_STATIC_API_KEY=

# Optional URL-safe base64 signing secret; server only, never NEXT_PUBLIC.
# Must belong to the project for the selected Maps Static API key.
GOOGLE_MAPS_STATIC_SIGNING_SECRET=
